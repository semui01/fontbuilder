{
  "name": "fontbuilder",
  "private": true,
  "version": "0.1.0",
  "description": "Turn handwriting into an installable font, entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.8",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
